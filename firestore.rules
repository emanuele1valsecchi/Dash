rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isOwner(resourceData) {
      return isSignedIn() && request.auth.uid == resourceData.userId;
    }
    // Reject any write that tries to set/modify a field the client must
    // never own. Used to protect aggregate counters and awarded points.
    function noServerOnlyFields(data, fields) {
      return !(fields.hasAny(data.keys()));
    }

    // ---------- profiles ----------
    match /profiles/{uid} {
      allow read: if isSignedIn();

      // On create the doc ID must equal the caller's UID, and totalPoints
      // is forced to zero. The client cannot self-award points.
      allow create: if isSelf(uid)
        && request.resource.data.totalPoints == 0
        && request.resource.data.userId == null  // userId is implicit (doc ID)
        || ( isSelf(uid)
             && request.resource.data.totalPoints == 0 );

      // The colour this player's territory is drawn in on everyone's map.
      // Only an index into the client's palette is stored, so it is not
      // trust-affecting the way totalPoints is — but it is read by *other*
      // users, so it still has to be a value the renderer can accept rather
      // than arbitrary client input. Absent is allowed: profiles created
      // before this field existed have not been backfilled, and the client
      // falls back to a uid hash for those.
      //
      // Keep the bound in step with PALETTE_SIZE in functions/index.js and
      // PlayerPalette.size in lib/utils/player_palette.dart.
      function validAreaColorIndex() {
        return !('areaColorIndex' in request.resource.data)
          || ( request.resource.data.areaColorIndex is int
               && request.resource.data.areaColorIndex >= 0
               && request.resource.data.areaColorIndex < 10 );
      }

      // On update, totalPoints must not be changed by the client.
      allow update: if isSelf(uid)
        && request.resource.data.totalPoints == resource.data.totalPoints
        && validAreaColorIndex();

      allow delete: if false; // disable client-side deletes

      // ---------- badge_progress (per-user progress toward each badge) ----------
      // Seeded by seedUserProfileAndBadges (Admin SDK) on signup and updated by
      // Cloud Functions as the user progresses. **Never client-writable** —
      // unlocking a badge is a trust value, same reasoning as userStats and
      // totalPoints.
      //
      // Readable by any signed-in user, not just its owner. Achievements are
      // meant to be seen: a public profile shows another user's badges
      // (`ProfileBadgeSection`, via `BadgeService.getAllBadges`), and the
      // claimed-area sheet marks an owner who holds the Duke badge. Both of
      // those were silently reading nothing under the old self-only rule —
      // every such read was denied, so someone else's badges always rendered
      // as locked at 0%. Widening the *read* leaves the trust boundary exactly
      // where it was, on writes.
      match /badge_progress/{badgeId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ---------- badges (shared reference data: title/description/image/order) ----------
    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow write: if false; // seed/admin-managed, not client-writable
    }

    // ---------- nicknames (uniqueness index) ----------
    match /nicknames/{nickname} {
      allow read: if isSignedIn();
      // Claim only if the document does not already exist and the caller
      // writes their own UID into it.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- follows ----------
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // ---------- routes ----------
    // Two shapes live here:
    //
    //  1. An OWNED route — planned by hand on the map, or saved from a
    //     parameter search. `userId` is its author, who may rename it.
    //
    //  2. A SHARED session route — the canonical copy of one run's path,
    //     created the first time any user favourites that run and then
    //     referenced by every later user who favourites it, instead of each
    //     of them storing their own byte-identical duplicate. It has NO
    //     owner (`userId == null`) and NO name (each user's own name for it
    //     lives on their `favoriteRoutes` link), and its document ID is the
    //     source session's ID — which is what makes the de-duplication
    //     collision-free without a lookup: two users favouriting the same
    //     run independently compute the same document ID.
    //
    //     THE CLIENT MAY NOT CREATE ONE. It is written only by the
    //     `favoriteSession` Cloud Function (Admin SDK), which copies the
    //     geometry out of the `runningSessions` doc itself. This is not
    //     optional strictness: a shared route is read by OTHER users, and
    //     rules can validate a document's *shape* but cannot verify that a
    //     client-supplied polyline actually matches the run it claims to
    //     come from — so a client-writable shared route would let anyone
    //     pre-create `routes/{sessionId}` for a not-yet-favourited run and
    //     poison the geometry every later user sees. The client sends an ID;
    //     the server decides what geometry that means.
    //
    //     It is created once and never rewritten — `allow update` below
    //     requires an owner, and a shared route has none — so later
    //     favourites of the same run cannot reshape geometry earlier ones
    //     already reference. It carries `isPublic: true` so the read rule
    //     lets every referencing user read it; this exposes nothing new,
    //     since the run it was copied from is already readable by any
    //     signed-in user (see the runningSessions read rule below).
    match /routes/{routeId} {
      // A route is readable by its owner, or by anyone once its owner has
      // made it public. `isPublic` is the author's own choice, set when the
      // route is saved and flippable afterwards from the route detail page —
      // it is what decides whether the route shows up on their profile for
      // other people (see `ProfileActivitySections`).
      //
      // Read as `get('isPublic', false)` rather than `resource.data.isPublic`
      // so a document written before the field existed is treated as private
      // instead of tripping an evaluation error on a missing key. Defaulting
      // to *private* is the whole point: nobody has opted in retroactively.
      //
      // The same flag also carries the older meaning it already had — a
      // shared session route (the ownerless copy of a run that favourites
      // point at) is written `isPublic: true` by the `favoriteSession` Cloud
      // Function so every user who favourited that run can read it. Both
      // cases say the same thing: "readable by someone other than the owner".
      //
      // `resource == null` (document does not exist) is allowed through so a
      // direct get() on a missing route returns an empty snapshot instead of
      // failing the whole read with permission-denied — dereferencing a null
      // resource is an evaluation error, which denies. Nothing is leaked by
      // it: a shared route's ID is a session ID, and every runningSessions
      // doc is already readable by any signed-in user, while an owned route's
      // ID is an unguessable Firestore auto-ID.
      allow read: if isSignedIn()
        && (resource == null
            || resource.data.userId == request.auth.uid
            || resource.data.get('isPublic', false) == true);

      // Owned routes only — a shared session route has no owner, so this
      // denies creating one. Only the favoriteSession Cloud Function can.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.distanceMeters is number
        && request.resource.data.isLoop is bool
        // Visibility must be stated explicitly and must be a boolean, so a
        // route can never end up public through a missing or malformed field.
        && request.resource.data.isPublic is bool;

      // Owner may rename. Geometry and visibility are both immutable.
      //
      // **`isPublic` is pinned, which is what makes the public/private choice
      // permanent** — it is decided once, at create, and there is no toggle
      // anywhere in the app. Enforcing it here rather than by simply not
      // building the toggle is the point: a client is not the thing that gets
      // to decide whether a route someone else may already have seen quietly
      // disappears, or whether a private one is suddenly published.
      //
      // A user who changes their mind deletes the route and saves it again,
      // which is honest — the new route is a new document, and nothing else
      // references it (favouriting copies a *run*, never an owned route).
      //
      // A shared session route has no owner, so this denies every client
      // write to one — including from the user who originally created it.
      //
      // Compared via get(..., false) on both sides, like the read rule: a
      // document predating the field would otherwise make this an evaluation
      // error and deny renaming it. Absent on both sides compares equal, and
      // adding `isPublic: true` to such a document still fails.
      allow update: if isOwner(resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.get('isPublic', false)
             == resource.data.get('isPublic', false)
        && request.resource.data.routePolyline == resource.data.routePolyline
        && request.resource.data.waypoints == resource.data.waypoints
        && request.resource.data.distanceMeters == resource.data.distanceMeters;

      // Likewise denies deleting a shared route: other users' favourites
      // reference it, so it must outlive any one of them un-favouriting.
      allow delete: if isOwner(resource.data);
    }

    // ---------- claimedAreas ----------
    // Area ownership is a trust value (see CLAUDE.md "Security & performance"
    // — the client must never assign itself a claimed area). Areas are
    // created only by the onRunningSessionCreateClaimedAreas Cloud Function
    // (Admin SDK, bypasses these rules) from a completed run's closed loops.
    match /claimedAreas/{areaId} {
      allow read: if isSignedIn();
      allow create: if false;
      allow update: if false; // claims are immutable once written
      allow delete: if isOwner(resource.data);
    }

    // ---------- runningSessions ----------
    match /runningSessions/{sessionId} {
      // Fields only onRunningSessionCreateClaimedAreas (Admin SDK, bypasses
      // these rules) may ever set, computed from the session's real
      // geometry/start point: territory placement, the XP breakdown, and
      // the completion sentinel the run-results popup waits on.
      function serverOnlyRunFields() {
        return ['territoryCity', 'territoryBroad', 'territoryBroadType',
                'totalAreaM2', 'stolenAreaM2', 'xpFromDistance', 'xpFromArea',
                'xpFromStolenArea', 'pointsProcessed'];
      }

      // Any signed-in user may read any session — not just its owner. This
      // is a deliberate exposure, not an oversight: a run's full GPS path
      // becomes visible to other users so a run-detail page (reached via a
      // claimed area's "built from N runs" list) can show the *whole*
      // running session it came from, and so a user can copy it into a new
      // `routes` doc of their own to re-run later. Read access alone
      // doesn't let anyone edit, delete, or claim credit for someone else's
      // run — this collection's trust boundary was always about writes
      // (see `serverOnlyRunFields`/`create`/`update` below), which this
      // doesn't touch.
      allow read: if isSignedIn();
      // Heart rate comes from a companion watch — the only device that can
      // measure it — so unlike points/territory it is legitimately
      // client-written. It is not trust-bearing: heart rate appears nowhere in
      // the XP formula. Absent is valid — most runs have no watch — but
      // present means a plausible bpm.
      function validHeartRate(data, field) {
        return !(field in data)
          || (data[field] is int && data[field] > 0 && data[field] <= 250);
      }

      // Heart rate no longer belongs on THIS document — it lives in the
      // owner-only `private` subcollection below, because everything here is
      // world-readable to signed-in users. These two clauses now exist to stop
      // a client putting it back: a run created with either field is rejected
      // outright rather than silently publishing a body metric.
      function noPublicHeartRate(data) {
        return !('avgHeartRateBpm' in data) && !('maxHeartRateBpm' in data);
      }

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.pointsEarned == 0
        && noPublicHeartRate(request.resource.data)
        && noServerOnlyFields(request.resource.data, serverOnlyRunFields());
      // Client may finalize the session (set endTime, stats) but cannot
      // change ownership, points, or any server-only field (Cloud Function
      // owns all of those — same trust-value reasoning as area
      // ownership/userStats). diff().affectedKeys() (same idiom already used
      // by the notifications rule below) naturally handles "field doesn't
      // exist yet" correctly, unlike comparing resource.data.<field> directly.
      allow update: if isOwner(resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.pointsEarned == resource.data.pointsEarned
        && noPublicHeartRate(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(serverOnlyRunFields());
      allow delete: if false;

      // ---------- runningSessions/{id}/private ----------
      // Body metrics: what a run cost the person, as opposed to where it went.
      //
      // **This subcollection exists because the parent document is readable by
      // every signed-in user** (see the read rule above, and why that exposure
      // is deliberate). Firestore cannot restrict individual fields of a
      // document that is readable at all, so anything genuinely private has to
      // live at a path with its own rule — hiding a widget in the app is not
      // privacy, it is decoration.
      //
      // Rules do NOT cascade into subcollections without a recursive wildcard,
      // so `allow read: if isSignedIn()` above does not reach here; this block
      // is the only thing granting access, and it grants it to the owner only.
      //
      // `userId` is denormalized onto each document so the rule can authorize
      // without a get() on the parent session — a get() inside a rule is a
      // billed read on every evaluation.
      //
      // Energy is deliberately NOT stored here (or anywhere): it is
      // distance * 70 kcal/km, and distance is public, so a private copy would
      // protect nothing while adding a second source of truth. See
      // `lib/utils/run_estimates.dart`.
      match /private/{docId} {
        // Note there is deliberately no `resource == null` escape hatch here,
        // unlike the favoriteRoutes rule below. A missing document has no
        // userId to check, so reading one is an evaluation error and denies —
        // including for its own owner, which is the normal case for a
        // phone-only run. That is the stronger choice: if absence read as an
        // empty snapshot while presence read as denied, any signed-in user
        // could tell which of someone else's runs carry watch data. Denying
        // both leaks nothing. `RunSessionRepository.fetchPrivateMetrics`
        // treats permission-denied as "no metrics" for exactly this reason.
        allow read: if isSignedIn()
          && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && validHeartRate(request.resource.data, 'avgHeartRateBpm')
          && validHeartRate(request.resource.data, 'maxHeartRateBpm');
        allow update: if isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && validHeartRate(request.resource.data, 'avgHeartRateBpm')
          && validHeartRate(request.resource.data, 'maxHeartRateBpm');
        // Deleting your own is allowed; account deletion also sweeps these
        // (see `deleteMyAccount` — a subcollection is not removed with its
        // parent).
        allow delete: if isSignedIn()
          && resource.data.userId == request.auth.uid;
      }
    }

    // ---------- userStats ----------
    // Read-only from the client. All writes go through Cloud Functions
    // using the Admin SDK, which bypasses these rules.
    match /userStats/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // ---------- favoriteRoutes ----------
    // Each doc links one user to one route they favourited. For a favourited
    // run this is the ONLY per-user document: the geometry itself lives in a
    // single shared `routes` doc (see the routes block above), so this link
    // is where anything personal about the favourite belongs — the user's own
    // name for it, and a denormalized summary so a list can be rendered from
    // one query without loading every polyline.
    match /favoriteRoutes/{favId} {
      // `resource` is null when the document does not exist, and
      // dereferencing null is an evaluation error — which denies the read.
      // That case is NOT an edge case here: "have I favourited this run?" is
      // answered by getting this exact document, and the usual answer is that
      // it isn't there yet. So nonexistence has to be handled explicitly.
      //
      // It is scoped by the ID's own uid prefix (which `create` guarantees,
      // and which the favoriteSession Cloud Function writes) rather than
      // allowed outright, so this can't be used to probe whether ANOTHER
      // user has favourited a given run: a missing doc under someone else's
      // prefix stays denied. split() is used rather than matches() because a
      // uid containing regex metacharacters would make a prefix regex match
      // too much — this way an unexpected uid shape fails closed.
      allow read: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid)
        || (resource == null && favId.split('_')[0] == request.auth.uid)
      );

      // Created only by the favoriteSession Cloud Function, together with the
      // shared route it points at. Keeping create server-side means a link can
      // never reference a route that does not exist, and the denormalized
      // summary on it is always the server's own copy of the run's real
      // numbers rather than whatever a client claimed they were.
      allow create: if false;

      // The owner may un-favourite, which deletes this link only — never the
      // shared route, which other users' links may still reference.
      allow delete: if isOwner(resource.data);

      // The owner may rename their own favourite. Restricted to `name`
      // specifically so `routeId` can't be repointed at a different route,
      // `userId` can't be reassigned, and the summary can't be falsified.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name']);
    }

    // ---------- notifications ----------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Only Cloud Functions create notifications.
      allow create: if false;
      // The recipient may only flip isRead / readAt.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isRead', 'readAt']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}