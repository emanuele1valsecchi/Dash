<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Marks this as a watch app: Play Store filtering, and the launcher only
         surfaces it on a watch. Required, not optional. -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- GPS for standalone recording, body sensors for heart rate. Both are
         declared required="false" deliberately: the Galaxy Watch 6 has both,
         but cheaper Wear OS watches ship without built-in GPS, and marking it
         required would hide the app from them entirely rather than letting it
         run in phone-companion mode. The app feature-detects at runtime. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.heartrate" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Heart rate needs BOTH, because which one applies depends on the OS.
         Android 15 (API 35) deprecated BODY_SENSORS in favour of Health
         Connect's granular permissions, and on Wear OS 6 the heart rate sensor
         is guarded by READ_HEART_RATE alone — verified via `dumpsys
         sensorservice` on a Galaxy Watch 6, which reports
         `perm: android.permission.health.READ_HEART_RATE`. Older Wear 3/4
         devices still gate it behind BODY_SENSORS, so both are declared and
         either being granted is treated as sufficient at runtime. -->
    <uses-permission android:name="android.permission.BODY_SENSORS"
        android:maxSdkVersion="34" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <!-- Ambient mode: without this the screen blanks a few seconds after
         wrist-down and the run screen is simply gone mid-workout. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="Dash"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- Declares the watch app works without a phone app installed. Even in
             companion mode this should stay true: the watch app is installable
             on its own, and standalone GPS recording is the eventual goal. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
